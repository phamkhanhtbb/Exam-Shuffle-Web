{
    "rewrites": [
        {
            "source": "/((?!sitemap.xml|robots.txt|static|favicon.ico).*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/sitemap.xml",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "application/xml"
                }
            ]
        }
    ],
    "cleanUrls": true,
    "trailingSlash": false
}